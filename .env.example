# Copier en .env.local et remplir depuis Supabase > Project Settings > API.
# .env.local est ignoré par git. Ne jamais committer de clé.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# La clé service_role n'a rien à faire ici.
# Elle ne sert que dans les tâches planifiées, jamais dans un chemin
# déclenché par une requête utilisateur (voir CLAUDE.md § 6).
