# Copier en .env.local pour le développement, et reporter les deux mêmes
# variables dans Vercel → Settings → Environment Variables.
# .env.local est ignoré par git. Ne jamais committer de clé.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé PUBLIABLE (Settings → API Keys). Les deux formats fonctionnent :
#   sb_publishable_…   format actuel
#   eyJ…               ancienne clé « anon », toujours acceptée
# Elle est destinée au navigateur : elle ne donne accès à rien par
# elle-même, c'est le RLS qui décide. La préfixer NEXT_PUBLIC_ est
# volontaire.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---------------------------------------------------------------------
# CE QUI N'A RIEN À FAIRE ICI
#
# La clé SECRÈTE (sb_secret_… / service_role) contourne le RLS sur tout
# le projet. Elle ne doit apparaître dans aucune variable NEXT_PUBLIC_,
# dans aucun fichier de ce dépôt, et dans aucun chemin déclenché par une
# requête utilisateur (CLAUDE.md § 6).
#
# Les scripts qui en ont besoin — déploiement, test d'isolation réel —
# la lisent depuis l'environnement du shell, le temps d'une commande :
#
#   SUPABASE_SECRET_KEY=… npm run test:isolation:live
# ---------------------------------------------------------------------
