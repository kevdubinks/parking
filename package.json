{
  "name": "parking-hotel",
  "version": "0.1.0",
  "private": true,
  "description": "Registre des plaques d'immatriculation pour parkings d'hôtels",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.mjs\"",
    "test:isolation": "node scripts/test-isolation.mjs",
    "test:isolation:install": "npm install --no-save --no-audit --no-fund embedded-postgres pg",
    "test:isolation:live": "node scripts/test-isolation-live.mjs",
    "deploy:supabase": "node scripts/deploy-supabase.mjs",
    "charte": "node scripts/charte.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
